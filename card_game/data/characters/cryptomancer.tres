[resource]
script = ExtResource("1")
id = "cryptomancer"
display_name = "ABYSS"
title = "Voice of the Corrupted"
character_class = 2
backstory = "Dr. Sera Voss was a theoretical cryptographer who believed she could communicate with the Angels. While others built weapons, she built bridges — translation algorithms designed to decode the angelic communication protocols. She succeeded. The Angels spoke to her. And what they said changed her.

Sera learned that the corruption seeping into operatives during Nexus dives isn't a side effect. It's a language. The Angels' code is alive, and it wants to be understood. She began deliberately absorbing corruption, learning to read its patterns, to speak its syntax. Her colleagues called her mad. She called herself fluent.

Abyss fights with a style that horrifies other operatives. She channels corruption as a weapon, turning the Angels' own code against them. The darkness that others resist, she embraces. Every dive takes her closer to something — or something closer to her."
passive_name = "Corrupted Resonance"
passive_description = "Start at 15 corruption. Deal +25% damage when corruption >= 50."
starter_deck = Array[String](["strike", "strike", "defend", "defend", "dark_compile", "void_channel", "dark_pulse", "shadow_weave", "bleed_logic", "whispered_axiom"])
starting_hp = 70
starting_energy = 3
color_primary = Color(0.55, 0.15, 0.75, 1)
color_secondary = Color(0.35, 0.1, 0.5, 1)
icon_text = "CM"
