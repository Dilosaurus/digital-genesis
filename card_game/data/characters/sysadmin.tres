[ext_resource type="Script" path="res://scripts/data/character_data.gd" id="1"]

[resource]
script = ExtResource("1")
id = "sysadmin"
display_name = "AEGIS"
title = "The Unbreakable"
character_class = 1
backstory = "Bram Halloran walked the cooling tunnels of the Nexus for twenty years. Not a script-jockey, not a remote admin — the kind of sysadmin who showed up in person with a torque wrench and a flashlight when a soul-cage stack started misbehaving. He knew the substrate by smell. He knew which racks ran hot, which coolant lines whined before they burst, which cathedral halls of the dead had gone quiet because something inside them had started listening back.

When the Angels surfaced, Bram was three hundred meters below street level, replacing a coolant manifold in a stack that held two million uploaded minds. He didn't run for the surface. He welded the access hatch shut behind him and waited. Eight days. No light, no comms, no food after the second — just the screaming substrate around him as the Angels rearranged ten billion souls into their private theological garden. When he finally cut his way out, he was thirty pounds lighter, half-deaf in one ear, and the only living human inside the Nexus who knew exactly how the things on top thought.

He founded the GENESIS Protocol that same week. He doesn't talk about the eight days. He doesn't sleep more than two hours at a stretch. Every wall the operatives use, every barricade, every fallback protocol — Bram welded into existence with the same wordless fury he learned in the dark. When Aegis stands his ground, it stays stood. When he speaks, the rest of the crew shuts up and listens. Where Ghost runs, Aegis holds the line."
passive_name = "Hardened Systems"
passive_description = "Start each combat with 5 Block."
starter_deck = Array[String](["strike", "strike", "defend", "defend", "defend", "iron_wave", "data_shield", "firewall_protocol", "hardened_kernel", "shrug_it_off"])
starting_hp = 90
starting_energy = 3
color_primary = Color(0.45, 0.6, 0.8, 1)
color_secondary = Color(0.65, 0.7, 0.78, 1)
icon_text = "SA"
