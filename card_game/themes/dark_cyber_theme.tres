[gd_resource type="Theme" format=3]

; ---------------------------------------------------------------------------
; dark_cyber_theme.tres
; Global dark fantasy theme for Digital Genesis.
; Warm golds/browns, dark backgrounds, polished flat styles.
; ---------------------------------------------------------------------------

; --- Panel StyleBoxes ---------------------------------------------------

[sub_resource type="StyleBoxFlat" id="panel_normal"]
