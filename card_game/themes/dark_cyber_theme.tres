Button/colors/icon_hover_color    = Color(1.00, 1.00, 0.85, 1.00)
Button/colors/icon_pressed_color  = Color(0.70, 0.62, 0.45, 1.00)
Button/colors/icon_disabled_color = Color(0.40, 0.38, 0.32, 0.60)
Button/font_sizes/font_size = 14
Button/constants/h_separation = 6

