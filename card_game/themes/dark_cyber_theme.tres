; =========================================================================
; Theme resource
; =========================================================================

[resource]

; --- Panel ---------------------------------------------------------------
Panel/styles/panel = SubResource("panel_normal")
PanelContainer/styles/panel = SubResource("panel_normal")

; --- Button --------------------------------------------------------------
Button/styles/normal   = SubResource("btn_normal")
Button/styles/hover    = SubResource("btn_hover")
Button/styles/pressed  = SubResource("btn_pressed")
Button/styles/disabled = SubResource("btn_disabled")
Button/styles/focus    = SubResource("btn_focus")

Button/colors/font_color          = Color(0.92, 0.85, 0.65, 1.00)
Button/colors/font_hover_color    = Color(1.00, 0.95, 0.75, 1.00)
Button/colors/font_pressed_color  = Color(0.70, 0.62, 0.45, 1.00)
Button/colors/font_disabled_color = Color(0.40, 0.38, 0.32, 0.60)
Button/colors/font_focus_color    = Color(1.00, 0.95, 0.75, 1.00)
