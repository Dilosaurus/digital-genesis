[gd_resource type="Theme" format=3]

; ---------------------------------------------------------------------------
; combat_theme.tres
; Combat-specific overrides — semi-transparent HUD panels, vivid End Turn.
; All flat StyleBoxes, warm dark fantasy palette.
; ---------------------------------------------------------------------------

; --- HUD Panel (semi-transparent overlay on the arena) -------------------

[sub_resource type="StyleBoxFlat" id="hud_panel"]
bg_color = Color(0.05, 0.04, 0.06, 0.82)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.40, 0.32, 0.20, 0.70)
corner_radius_top_left = 6
corner_radius_top_right = 6
corner_radius_bottom_right = 6
corner_radius_bottom_left = 6
content_margin_left = 6.0
content_margin_top = 4.0
content_margin_right = 6.0
content_margin_bottom = 4.0

; --- End Turn button — vivid green, prominent ----------------------------

[sub_resource type="StyleBoxFlat" id="end_turn_normal"]
bg_color = Color(0.12, 0.30, 0.12, 1.0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.30, 0.75, 0.30, 1.0)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 18.0
content_margin_top = 8.0
content_margin_right = 18.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="end_turn_hover"]
bg_color = Color(0.18, 0.45, 0.18, 1.0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.40, 0.95, 0.40, 1.0)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 18.0
content_margin_top = 8.0
content_margin_right = 18.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxFlat" id="end_turn_pressed"]
bg_color = Color(0.08, 0.22, 0.08, 1.0)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.25, 0.60, 0.25, 1.0)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 18.0
content_margin_top = 10.0
content_margin_right = 18.0
content_margin_bottom = 6.0

[sub_resource type="StyleBoxFlat" id="end_turn_disabled"]
bg_color = Color(0.08, 0.10, 0.08, 0.60)
border_width_left = 2
border_width_top = 2
border_width_right = 2
border_width_bottom = 2
border_color = Color(0.20, 0.28, 0.20, 0.50)
corner_radius_top_left = 8
corner_radius_top_right = 8
corner_radius_bottom_right = 8
corner_radius_bottom_left = 8
content_margin_left = 18.0
content_margin_top = 8.0
content_margin_right = 18.0
content_margin_bottom = 8.0

[sub_resource type="StyleBoxEmpty" id="btn_focus_empty"]

; --- HP bar fills --------------------------------------------------------

[sub_resource type="StyleBoxFlat" id="hp_bar_bg"]
bg_color = Color(0.08, 0.07, 0.06, 1.0)
border_width_left = 1
border_width_top = 1
border_width_right = 1
border_width_bottom = 1
border_color = Color(0.35, 0.28, 0.18, 1.0)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

[sub_resource type="StyleBoxFlat" id="hp_bar_fill"]
bg_color = Color(0.15, 0.82, 0.30, 1.0)
corner_radius_top_left = 4
corner_radius_top_right = 4
corner_radius_bottom_right = 4
corner_radius_bottom_left = 4

; =========================================================================
; Theme resource
; =========================================================================

[resource]

Panel/styles/panel = SubResource("hud_panel")
PanelContainer/styles/panel = SubResource("hud_panel")

Button/styles/normal   = SubResource("end_turn_normal")
Button/styles/hover    = SubResource("end_turn_hover")
Button/styles/pressed  = SubResource("end_turn_pressed")
Button/styles/disabled = SubResource("end_turn_disabled")
Button/styles/focus    = SubResource("btn_focus_empty")
Button/colors/font_color          = Color(0.85, 1.00, 0.85, 1.00)
Button/colors/font_hover_color    = Color(1.00, 1.00, 1.00, 1.00)
Button/colors/font_pressed_color  = Color(0.70, 0.90, 0.70, 1.00)
Button/colors/font_disabled_color = Color(0.40, 0.45, 0.40, 0.60)
Button/colors/font_focus_color    = Color(1.00, 1.00, 1.00, 1.00)
Button/font_sizes/font_size = 18

Label/colors/font_color        = Color(0.95, 0.92, 0.82, 1.00)
Label/colors/font_shadow_color = Color(0.00, 0.00, 0.00, 0.80)
Label/font_sizes/font_size = 14
Label/constants/shadow_offset_x   = 1
Label/constants/shadow_offset_y   = 1
Label/constants/shadow_as_outline  = 0

RichTextLabel/colors/default_color    = Color(0.92, 0.88, 0.78, 1.00)
RichTextLabel/colors/font_shadow_color = Color(0.00, 0.00, 0.00, 0.80)
RichTextLabel/colors/selection_color  = Color(0.55, 0.40, 0.20, 0.50)
RichTextLabel/font_sizes/normal_font_size = 12
RichTextLabel/constants/shadow_offset_x  = 1
RichTextLabel/constants/shadow_offset_y  = 1

ProgressBar/styles/background = SubResource("hp_bar_bg")
ProgressBar/styles/fill       = SubResource("hp_bar_fill")
ProgressBar/colors/font_color        = Color(1.00, 1.00, 0.95, 0.90)
ProgressBar/colors/font_shadow_color = Color(0.00, 0.00, 0.00, 0.90)
ProgressBar/font_sizes/font_size = 11
ProgressBar/constants/shadow_offset_x = 1
ProgressBar/constants/shadow_offset_y = 1
