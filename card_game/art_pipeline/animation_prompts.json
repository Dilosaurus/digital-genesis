        {"skeleton": "idle/idle_04.png", "prompt_hint": "slight exhale, settling, subtle weight shift"}
      ]
    },
    "attack_melee": {
      "label": "Melee Attack",
      "frame_count": 6,
      "loop": false,
      "fps": 8,
      "frames": [
        {"skeleton": "attack/melee_windup_01.png", "prompt_hint": "pulling weapon back, winding up for strike"},
        {"skeleton": "attack/melee_windup_02.png", "prompt_hint": "weapon fully raised, about to strike, tension"},
        {"skeleton": "attack/melee_swing_01.png", "prompt_hint": "swinging forward, mid-strike, motion blur"},
        {"skeleton": "attack/melee_swing_02.png", "prompt_hint": "strike connecting, impact moment, energy burst"},
        {"skeleton": "attack/melee_follow_01.png", "prompt_hint": "follow through, weapon extended, energy trail"},
        {"skeleton": "attack/melee_recover.png", "prompt_hint": "recovering stance, pulling weapon back, settling"}
