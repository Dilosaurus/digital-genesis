        {"skeleton": "attack/cast_follow.png", "prompt_hint": "energy trail from hands, projectile flying, aftermath"},
        {"skeleton": "attack/cast_recover.png", "prompt_hint": "hands lowering, energy dissipating, recovering"}
      ]
    },
    "hit": {
      "label": "Hit Reaction",
      "frame_count": 3,
      "loop": false,
