        {"skeleton": "block/block_raise.png", "prompt_hint": "raising guard, arms coming up, bracing"},
        {"skeleton": "block/block_hold.png", "prompt_hint": "fully guarding, shield up, solid defense"},
        {"skeleton": "block/block_lower.png", "prompt_hint": "lowering guard, relaxing, returning to stance"}
      ]
    },
    "death": {
      "label": "Death",
      "frame_count": 4,
      "loop": false,
      "fps": 4,
      "frames": [
        {"skeleton": "death/death_stagger.png", "prompt_hint": "staggering, losing balance, final hit"},
        {"skeleton": "death/death_fall_01.png", "prompt_hint": "falling, knees buckling, collapsing"},
        {"skeleton": "death/death_fall_02.png", "prompt_hint": "hitting ground, crumpling, defeated"},
        {"skeleton": "death/death_final.png", "prompt_hint": "on ground, motionless, fading, defeated"}
      ]
    }
