; Engine configuration file.

[application]

config/name="Digital Genesis"
config/description="A Slay the Spire-inspired co-op deck-builder roguelike"
run/main_scene="res://scenes/main/main_menu.tscn"
config/features=PackedStringArray("4.6")

[autoload]

EventBus="*res://scripts/autoload/event_bus.gd"
GameManager="*res://scripts/autoload/game_manager.gd"
NetworkManager="*res://scripts/autoload/network_manager.gd"
SFXManager="*res://scripts/autoload/sfx_manager.gd"
TransitionManager="*res://scripts/autoload/transition_manager.gd"

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
