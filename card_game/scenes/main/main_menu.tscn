horizontal_alignment = 1
theme_override_fonts/font = ExtResource("4_font_btn")
theme_override_font_sizes/font_size = 11
theme_override_colors/font_color = Color(0.60, 0.52, 0.40, 0.80)

[node name="TitleDivider" type="TextureRect" parent="ContentRoot/MainColumn/TitleBlock"]
layout_mode = 2
