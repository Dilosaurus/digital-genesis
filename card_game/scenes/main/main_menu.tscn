; =============================================================================
; Scene tree
; =============================================================================

[node name="MainMenu" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
theme = ExtResource("2_theme")
script = ExtResource("1_script")

; --- Background stack (bottom to top) ---

[node name="BgBase" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0.04, 0.03, 0.10, 1.0)
mouse_filter = 2

[node name="BgGodRays" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0)
material = SubResource("mat_rays")
mouse_filter = 2

[node name="BgDigitalRain" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0)
material = SubResource("mat_rain")
mouse_filter = 2

[node name="BgNeonPulse" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0)
material = SubResource("mat_pulse")
mouse_filter = 2

; Scanlines + vignette go ABOVE shaders but BELOW all UI
[node name="ScanLines" type="ColorRect" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
color = Color(0, 0, 0, 0)
material = SubResource("mat_scan")
mouse_filter = 2

; --- Main content column (centered, anchored) ---

[node name="ContentRoot" type="CenterContainer" parent="."]
layout_mode = 1
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
mouse_filter = 2

[node name="MainColumn" type="VBoxContainer" parent="ContentRoot"]
layout_mode = 2
custom_minimum_size = Vector2(360, 0)
theme_override_constants/separation = 0

; --- Title block (upper third) ---

[node name="TitleBlock" type="VBoxContainer" parent="ContentRoot/MainColumn"]
layout_mode = 2
theme_override_constants/separation = 8

[node name="TitleLabel" type="Label" parent="ContentRoot/MainColumn/TitleBlock"]
layout_mode = 2
text = "deus.exe"
horizontal_alignment = 1
theme_override_fonts/font = ExtResource("3_font_title")
theme_override_font_sizes/font_size = 54
theme_override_colors/font_color = Color(0.95, 0.82, 0.50, 1.0)
theme_override_colors/font_shadow_color = Color(0.55, 0.35, 0.15, 0.55)
theme_override_constants/shadow_offset_x = 0
theme_override_constants/shadow_offset_y = 2
theme_override_constants/shadow_as_outline = 1

[node name="SubtitleLabel" type="Label" parent="ContentRoot/MainColumn/TitleBlock"]
