[gd_scene load_steps=19 format=3]

[ext_resource type="Script" path="res://scripts/scenes/main_menu.gd" id="1_script"]
[ext_resource type="Theme" path="res://themes/dark_cyber_theme.tres" id="2_theme"]
[ext_resource type="FontFile" path="res://assets/fonts/CinzelDecorative-Regular.ttf" id="3_font_title"]
[ext_resource type="FontFile" path="res://assets/fonts/Lato-Bold.ttf" id="4_font_btn"]
[ext_resource type="FontFile" path="res://assets/fonts/ShareTechMono-Regular.ttf" id="5_font_mono"]
[ext_resource type="Shader" path="res://shaders/digital_rain.gdshader" id="6_shader_rain"]
[ext_resource type="Shader" path="res://shaders/god_rays.gdshader" id="7_shader_rays"]
[ext_resource type="Shader" path="res://shaders/neon_pulse.gdshader" id="8_shader_pulse"]
[ext_resource type="Shader" path="res://shaders/scanlines_vignette.gdshader" id="9_shader_scan"]

; --- Background shader materials ---

[sub_resource type="ShaderMaterial" id="mat_rain"]
shader = ExtResource("6_shader_rain")
shader_parameter/rain_color = Color(0.1, 0.5, 0.9, 1.0)
shader_parameter/fall_speed = 1.4
shader_parameter/density = 22.0
shader_parameter/opacity = 0.07

[sub_resource type="ShaderMaterial" id="mat_rays"]
shader = ExtResource("7_shader_rays")
shader_parameter/light_origin = Vector2(0.5, 0.08)
shader_parameter/ray_intensity = 0.09
shader_parameter/ray_count = 8.0
shader_parameter/ray_spread = 1.6
shader_parameter/sway_speed = 0.18
shader_parameter/ray_color = Color(0.35, 0.25, 0.85, 1.0)

[sub_resource type="ShaderMaterial" id="mat_pulse"]
shader = ExtResource("8_shader_pulse")
shader_parameter/glow_color = Color(0.3, 0.15, 0.65, 1.0)
shader_parameter/pulse_speed = 0.7
shader_parameter/min_intensity = 0.015
shader_parameter/max_intensity = 0.06

[sub_resource type="ShaderMaterial" id="mat_scan"]
shader = ExtResource("9_shader_scan")
shader_parameter/scanline_opacity = 0.09
shader_parameter/scanline_density = 200.0
shader_parameter/vignette_strength = 1.3
shader_parameter/vignette_softness = 0.55
shader_parameter/scroll_offset = 0.0

